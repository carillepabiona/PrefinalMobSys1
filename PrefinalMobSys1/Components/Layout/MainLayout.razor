@using PrefinalMobSys1.Components
@using PrefinalMobSys1.Services;
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
<div class="page">
    @*<div class="sidebar">
        <NavMenu />
    </div>*@ 
    @**@
    <main>
        <div class="topbar">
            <span class="leftside">
                <button id="btnMenu" class="btn text-primary" href="javascript:void(0)" onclick="toggleMenu()">
                    <i class="fa fa-bars"></i>
                </button>
                <button id="btnMenuClose" style="display:none" class="btn text-danger" href="javascript:void(0)" onclick="$('.mobile-nav').toggleClass('open');$('#btnMenu').toggle();$('#btnMenuClose').toggle()">
                    <i class="fa fa-times"></i>
                </button>
            </span>

            <span class="rightside">
                <SectionOutlet SectionName="page-buttons" />                
            </span>
        </div>
        <NavMenu />
        <article class="content px-4" onclick="hideMenu()" style="margin-top: 70px;">
            @Body
        </article>
        <div class="bottom-nav">
            <button class="nav-btn" @onclick="@(() => NavigationManager.NavigateTo("/home"))" aria-label="Home"
                    style="@GetNavButtonColor("/home")">
                <i class="fa fa-home" ></i>
            </button>
            <button class="nav-btn" @onclick="@(() => NavigationManager.NavigateTo("/creategroups"))" aria-label="Create Groups"
                    style="@GetNavButtonColor("/creategroups")">
                <i class="fa fa-users"></i>
            </button>
            <button class="nav-btn" @onclick="@(() => NavigationManager.NavigateTo("/"))" aria-label="Profile"
                    style="@GetNavButtonColor("/")">
                <i class="fa fa-user"></i>
            </button>
            <button class="nav-btn" @onclick="@(() => NavigationManager.NavigateTo("/settings"))" aria-label="Settings"
                    style="@GetNavButtonColor("/settings")">
                <i class="fa fa-cog"></i>
            </button>
        </div>
    </main>

</div>
<script>
    function toggleMenu() {
        $('.mobile-nav').toggleClass('open');
        $('#btnMenu').toggle();
        $('#btnMenuClose').toggle();
    }

    function showMenu() {
        $('.mobile-nav').addClass('open');
        $('#btnMenu').hide();
        $('#btnMenuClose').show();
    }

    function hideMenu() {
        $('.mobile-nav').removeClass('open');
        $('#btnMenu').show();
        $('#btnMenuClose').hide();
    }
</script>

@code{
    private List<string> Themes = new()
    {
        "light", "dark", "blue", "pink", "green", "purple", "orange", "teal"
    };

    private void ChangeTheme(string theme)
    {
        ThemeService.SetTheme(theme);
    }
    private string GetThemeColor(string theme) => theme switch
    {
        "light" => "#ffffff",
        "dark" => "#121212",
        "blue" => "#1E90FF",
        "pink" => "#FF69B4",
        "green" => "#28a745",
        "purple" => "#800080",
        "orange" => "#FFA500",
        "teal" => "#008080",
        _ => "#ffffff"
    };
    private string GetNavButtonColor(string navPath)
    {
        var currentUri = NavigationManager.Uri;
        var baseUri = NavigationManager.BaseUri;
        var relativePath = currentUri.StartsWith(baseUri) ? currentUri[baseUri.Length..] : currentUri;

        if (!relativePath.StartsWith("/"))
            relativePath = "/" + relativePath;

        bool isActive = relativePath == navPath;

        if (isActive)
        {
            // Special handling for light theme to use black icon color
            var currentTheme = ThemeService.CurrentTheme;
            var color = currentTheme == "light" ? "black" : GetThemeColor(currentTheme);
            return $"color: {color}; font-weight: bold;";
        }
        else
        {
            return "color: gray;";
        }
    }

}