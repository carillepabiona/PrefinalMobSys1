@page "/profile"
@using PrefinalMobSys1.Data;
@using PrefinalMobSys1.Models
@inject NavigationManager NavigationManager
@inject AppShellContext AppShellContext

<head>
    <link rel="stylesheet" href="css/profileStyle.css">
</head>
<div class="create-account-container">
    <h3>My Profile</h3>

    @if (CurrentUser == null)
    {
        <p>Loading profile...</p>
    }
    else
    {
        <div class="photo-upload" title="Profile Photo">
            <div class="photo-placeholder">
                <img src="imgs/user.jpeg" alt="Profile Image" style="width: 100px; height: 100px; border-radius: 50%;" />
            </div>
            <div class="photo-note">Click to change photo (not implemented)</div>
        </div>

        <div class="form-field">
            <i class="fa fa-user icon"></i>
            <input class="form-input" readonly value="@($"{CurrentUser.FirstName} {CurrentUser.LastName}")" />
        </div>

        <div class="form-field">
            <i class="fa fa-phone icon"></i>
            <input class="form-input" readonly value="@CurrentUser.MobileNumber" />
        </div>

        <div class="form-field">
            <i class="fa fa-envelope icon"></i>
            <input class="form-input" readonly value="@CurrentUser.Email" />
        </div>

        <div class="form-field">
            <i class="fa fa-home icon"></i>
            <input class="form-input" readonly value="@CurrentUser.Address" />
        </div>

        <div class="form-field">
            <i class="fa fa-briefcase icon"></i>
            <input class="form-input" readonly value="@CurrentUser.WorkInfo" />
        </div>

        <div class="button-group">
            <button class="save-button" @onclick="NavigateToEditProfile">Edit Profile</button>
            <button class="cancel-button" @onclick="NavigateToHome">Cancel</button>
        </div>
    }
</div>


@code {
    private User? CurrentUser;

    protected override void OnInitialized()
    {
        CurrentUser = AppShellContext.Instance?.CurrentUser;
    }

    private void NavigateToFavorites() => NavigationManager.NavigateTo("/favorites");
    private void NavigateToEditProfile() => NavigationManager.NavigateTo("/editprofile");
    private void NavigateToSettings() => NavigationManager.NavigateTo("/settings");
    private void NavigateToHome() => NavigationManager.NavigateTo("/");
}
