@page "/"
@using System.Linq

<head>
    <link rel="stylesheet" href="css/style.css">
</head>

<div class="contacts-container">
    <div class="top-bar">
        <h3>Contacts</h3>
        <button class="add-btn" @onclick="AddContact">+</button>
    </div>

    <div class="search-wrapper">
        <input class="search-input" type="text" placeholder="Search" @bind="searchTerm" />
        </div>

    <!-- Contacts List with Letter Grouping -->
<div class="contacts-list">
    @if (!FilteredContacts.Any())
    {
            <div class="no-contacts">No contacts found.</div>
    }
    else
    {
            @foreach (var group in FilteredContacts.OrderBy(c => c.Name).GroupBy(c => c.Name.Substring(0, 1).ToUpper()))
            {
                <div class="contact-section">
                    <h4 class="section-header">@group.Key</h4>
                    @foreach (var contact in group)
                    {
                        <div class="contact-card">
                        <div class="avatar">
                                <img src="https://via.placeholder.com/40" />
                        </div>
                            <div class="contact-details">
                                <div class="contact-name">@contact.Name</div>
                                <div class="contact-location">@contact.Phone</div>
                        </div>
                    </div>
                    }
                    </div>
            }
    }
</div>

    <div class="bottom-nav">
        <i class="fa fa-home"></i>
        <i class="fa fa-comment"></i>
        <i class="fa fa-user active"></i>
        <i class="fa fa-cog"></i>
    </div>
</div>

@code {
    public class Contact
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }

    private string searchTerm = "";
    private List<Contact> contacts = new()
    {
        new Contact { Id = 1, Name = "Alice Smith", Phone = "555-1234", Email = "alice@example.com" },
        new Contact { Id = 2, Name = "Bob Johnson", Phone = "555-5678", Email = "bob@example.com" },
        new Contact { Id = 3, Name = "Charlie Brown", Phone = "555-8765", Email = "charlie@example.com" }
    };


    }
