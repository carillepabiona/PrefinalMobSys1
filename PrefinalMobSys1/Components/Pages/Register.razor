@page "/register"
<head>
    <link rel="stylesheet" href="css/resgisterStyle.css">
</head>
<form @onsubmit="RegisterUser" class="register-form">

    <div class="register-card">
        <div class="register-header">
            <h2>
                Let’s<br /><strong>Register<br />Your Account</strong>
            </h2>
            <button type="button"></button>
        </div>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="status-message">
                <i class="fa fa-info-circle"></i>&nbsp;
                @StatusMessage
            </div>
        }

        <div class="inputs-container">
            <div class="input-wrapper">
                <span>👤</span>
                <input type="text" placeholder="Username" @bind="Model.Username" />
            </div>

            <div class="input-wrapper">
                <span>🔒</span>
                <input type="password" placeholder="Password" @bind="Model.Password" />
            </div>

            <div class="input-wrapper">
                <span>👤</span>
                <input type="text" placeholder="First Name" @bind="Model.FirstName" />
            </div>

            <div class="input-wrapper">
                <span>👤</span>
                <input type="text" placeholder="Last Name" @bind="Model.LastName" />
            </div>

            <div class="input-wrapper">
                <span>📞</span>
                <input type="text" placeholder="Mobile" @bind="Model.MobileNumber" />
            </div>

            <div class="input-wrapper">
                <span>🏠</span>
                <textarea placeholder="Address" @bind="Model.Address" rows="2"></textarea>
            </div>
        </div>

        <div class="checkbox-container">
            <input type="checkbox" id="agreeTerms" />
            <label for="agreeTerms">I agree to the <a href="#">Terms & Privacy</a></label>
        </div>

        <button type="submit" class="submit-button">
            Sign Up
        </button>

        <p class="footer-text">
            Have an account? <a href="/login">Sign In</a>
        </p>
    </div>

</form>
